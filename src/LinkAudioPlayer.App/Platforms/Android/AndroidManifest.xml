<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- android:icon and android:roundIcon must be declared here. Without them the
       generated mipmap resources are packaged but never referenced, and the launcher
       falls back to the default Android robot. -->
  <application
      android:allowBackup="true"
      android:icon="@mipmap/appicon"
      android:roundIcon="@mipmap/appicon_round"
      android:supportsRtl="true"
      android:usesCleartextTraffic="false" />

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- Keeps audio running once the screen locks. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <!-- Android 13 and later require consent before the media notification appears. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
