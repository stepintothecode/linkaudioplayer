<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- android:icon and android:roundIcon must be declared here. Without them the
       generated mipmap resources are packaged but never referenced, and the launcher
       falls back to the default Android robot. -->
  <application
      android:allowBackup="true"
      android:icon="@mipmap/appicon"
      android:roundIcon="@mipmap/appicon_round"
      android:supportsRtl="true"
      android:usesCleartextTraffic="false" />

  <!-- Required before an external browser launch will resolve on Android 11 and later.
       Without it the call silently does nothing. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
  </queries>

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- Keeps audio running once the screen locks. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <!-- Reads the music already on the phone, to show its folders as playlists. Read only:
       saving a file goes through the system save dialog, which needs no permission.
       Android 13 split storage by media type; older versions use the general permission. -->
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

  <!-- Android 13 and later require consent before the media notification appears. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
