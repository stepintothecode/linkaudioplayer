<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>LinkAudioPlayer.App</RootNamespace>

    <ApplicationTitle>LinkAudioPlayer</ApplicationTitle>
    <ApplicationId>com.kartikeyan.linkaudioplayer</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>

    <!-- The MAUI templates ship XML docs off. Public API here is app wiring, not a library. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- EF Core 10.0.0 ships a broken trim annotation on ExecuteUpdateAsync, which the
         repo-wide TreatWarningsAsErrors turns into a failed Release link. Drop once fixed. -->
    <NoWarn>$(NoWarn);IL2037</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2037</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinkAudioPlayer.Data\LinkAudioPlayer.Data.csproj" />
    <ProjectReference Include="..\LinkAudioPlayer.Extraction\LinkAudioPlayer.Extraction.csproj" />
    <ProjectReference Include="..\LinkAudioPlayer.Library\LinkAudioPlayer.Library.csproj" />
    <ProjectReference Include="..\LinkAudioPlayer.Playback\LinkAudioPlayer.Playback.csproj" />
    <ProjectReference Include="..\LinkAudioPlayer.Storage\LinkAudioPlayer.Storage.csproj" />
    <ProjectReference Include="..\LinkAudioPlayer.Ui\LinkAudioPlayer.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Xamarin.AndroidX.Media" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#101014" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#101014" BaseSize="192,192" />
  </ItemGroup>

</Project>
