{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Library": "Data Source=data/library.db"
  },
  "YtDlp": {
    "ExecutablePath": "yt-dlp",
    "AudioFormat": "bestaudio/best",
    "MetadataTimeoutSeconds": 60,
    "DownloadTimeoutSeconds": 600
  },
  "MediaCache": {
    "Directory": "data/media"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  }
}
