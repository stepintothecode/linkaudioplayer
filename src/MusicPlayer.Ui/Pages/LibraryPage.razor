@page "/"
@inject TrackLibraryService LibraryService
@inject PlayerController Player

<h1 class="visually-hidden">Library</h1>

<div class="row">
    <input type="url"
           placeholder="Paste a YouTube link and press Add"
           @bind="_url"
           @bind:event="oninput"
           @onkeydown="OnKeyDown" />
    <button class="primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_url))" @onclick="AddAsync">
        @(_busy ? "Adding" : "Add")
    </button>
</div>

@if (_error is { } error)
{
    <div class="error">@error</div>
}

<h2>Tracks (@_tracks.Count)</h2>

@if (_tracks.Count == 0)
{
    <p class="empty">Nothing here yet. Add a link above.</p>
}
else
{
    <ul class="list">
        @foreach (var (entry, index) in _tracks.Select((t, i) => (t, i)))
        {
            <li class="item @(Player.Current?.Id == entry.Track.Id ? "playing" : "")">
                <img class="art" src="@Artwork(entry.Track)" alt="" loading="lazy" />
                <div class="meta">
                    <span class="title">@entry.Track.Title</span>
                    <span class="sub">
                        @(entry.Track.Artist ?? entry.Track.Provider)
                        @if (entry.IsDownloaded)
                        {
                            <span class="badge cached">offline</span>
                        }
                    </span>
                </div>
                <button class="icon" title="Play" @onclick="() => PlayFromAsync(index)">▶</button>
                <button class="icon" title="Download for offline"
                        disabled="@(entry.IsDownloaded || _downloading.Contains(entry.Track.Id))"
                        @onclick="() => DownloadAsync(entry.Track.Id)">⬇</button>
                <button class="icon" title="Remove" @onclick="() => DeleteAsync(entry.Track.Id)">✕</button>
            </li>
        }
    </ul>
}

@code {
    private List<LibraryTrack> _tracks = [];
    private readonly HashSet<Guid> _downloading = [];
    private string _url = string.Empty;
    private string? _error;
    private bool _busy;

    /// <summary>Loads the library on first render.</summary>
    protected override async Task OnInitializedAsync() => await RefreshAsync();

    /// <summary>Submits the URL when the user presses Enter.</summary>
    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await AddAsync();
        }
    }

    /// <summary>Resolves the entered URL and adds the track.</summary>
    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_url) || _busy)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            await LibraryService.AddFromUrlAsync(_url.Trim(), CancellationToken.None);
            _url = string.Empty;
            await RefreshAsync();
        }
        catch (MediaResolutionException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Queues the whole library starting at the chosen track.</summary>
    private async Task PlayFromAsync(int index) =>
        await Player.PlayQueueAsync(_tracks.Select(t => t.Track), index);

    /// <summary>Downloads a track so it plays instantly and works offline.</summary>
    private async Task DownloadAsync(Guid trackId)
    {
        _error = null;
        _downloading.Add(trackId);

        try
        {
            await LibraryService.DownloadAsync(trackId, progress: null, CancellationToken.None);
        }
        catch (MediaResolutionException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _downloading.Remove(trackId);
            await RefreshAsync();
        }
    }

    /// <summary>Removes a track and its downloaded audio.</summary>
    private async Task DeleteAsync(Guid trackId)
    {
        await LibraryService.DeleteAsync(trackId, CancellationToken.None);
        await RefreshAsync();
    }

    /// <summary>Reloads the track list.</summary>
    private async Task RefreshAsync() =>
        _tracks = [.. await LibraryService.ListAsync(CancellationToken.None)];

    /// <summary>Falls back to the app icon when a track has no artwork.</summary>
    private static string Artwork(Track track) =>
        track.ThumbnailUrl ?? "_content/MusicPlayer.Ui/icon.svg";
}
