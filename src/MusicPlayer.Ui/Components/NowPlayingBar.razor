@implements IDisposable
@inject PlayerController Player

@* Mirrors what the Android lock screen shows. *@
@if (Player.Current is { } track)
{
    <div class="player">
        <div class="inner">
            <button class="icon" title="Previous" @onclick="Player.PreviousAsync">&#9198;</button>
            <button class="icon primary" title="Play or pause" disabled="@Player.IsPreparing"
                    @onclick="Player.TogglePlayPauseAsync">
                @(Player.IsPlaying ? "⏸" : "▶")
            </button>
            <button class="icon" title="Next" @onclick="Player.NextAsync">&#9197;</button>

            <div class="track">
                <span class="title">@track.Title</span>
                @if (Player.IsPreparing)
                {
                    <span class="time">Downloading @($"{Player.PrepareProgress:P0}")</span>
                    <progress class="prepare" max="1" value="@Player.PrepareProgress"></progress>
                }
                else
                {
                    <span class="time">@Format(Player.Position) / @Format(Player.Duration)</span>
                    <input type="range"
                           min="0"
                           max="@Math.Max(Player.Duration.TotalSeconds, 1)"
                           step="1"
                           value="@Player.Position.TotalSeconds"
                           @onchange="OnSeek" />
                }
            </div>

            <button class="icon @(Player.Repeat == RepeatMode.Off ? "" : "on")"
                    title="@($"Repeat: {Player.Repeat}")" @onclick="Player.CycleRepeat">
                @(Player.Repeat == RepeatMode.One ? "\U0001F502" : "\U0001F501")
            </button>
            <button class="icon" title="Stop" @onclick="Player.StopAsync">&#9209;</button>
        </div>

        @if (Player.Error is { } error)
        {
            <div class="error">@error</div>
        }
    </div>
}

@code {
    /// <summary>Subscribes to player state so the bar redraws as playback progresses.</summary>
    protected override void OnInitialized() => Player.StateChanged += OnStateChanged;

    /// <summary>Unsubscribes to avoid leaking the handler.</summary>
    public void Dispose() => Player.StateChanged -= OnStateChanged;

    /// <summary>Marshals the player callback onto the renderer thread.</summary>
    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Seeks when the user drags the scrubber.</summary>
    private async Task OnSeek(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var seconds))
        {
            await Player.SeekAsync(TimeSpan.FromSeconds(seconds));
        }
    }

    /// <summary>Formats a duration as m:ss.</summary>
    private static string Format(TimeSpan value) => value.ToString(@"m\:ss");
}
