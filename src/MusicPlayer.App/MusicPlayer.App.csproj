<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>MusicPlayer.App</RootNamespace>

    <ApplicationTitle>Music Player</ApplicationTitle>
    <ApplicationId>com.kartikeyan.musicplayer</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>

    <!-- The MAUI templates ship XML docs off. Public API here is app wiring, not a library. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- EF Core 10.0.0 ships a broken trim annotation on ExecuteUpdateAsync, which the
         repo-wide TreatWarningsAsErrors turns into a failed Release link. Drop once fixed. -->
    <NoWarn>$(NoWarn);IL2037</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2037</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicPlayer.Data\MusicPlayer.Data.csproj" />
    <ProjectReference Include="..\MusicPlayer.Extraction\MusicPlayer.Extraction.csproj" />
    <ProjectReference Include="..\MusicPlayer.Library\MusicPlayer.Library.csproj" />
    <ProjectReference Include="..\MusicPlayer.Playback\MusicPlayer.Playback.csproj" />
    <ProjectReference Include="..\MusicPlayer.Storage\MusicPlayer.Storage.csproj" />
    <ProjectReference Include="..\MusicPlayer.Ui\MusicPlayer.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Xamarin.AndroidX.Media" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#101014" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#101014" BaseSize="128,128" />
    <MauiAsset Include="wwwroot\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
