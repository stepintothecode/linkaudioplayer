@* Inline SVG rather than emoji. Android renders emoji in their own colours, which is
   why the shuffle, loop and stop glyphs came out yellow and white regardless of the
   button. These inherit currentColor, so a button controls its own icon. *@
<svg class="icon-svg @Class" viewBox="0 0 24 24" width="@Size" height="@Size"
     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
     stroke-linejoin="round" aria-hidden="true" focusable="false">
    @((MarkupString)Path(Name))
</svg>

@code {
    /// <summary>Which icon to draw.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>Edge length in pixels.</summary>
    [Parameter]
    public int Size { get; set; } = 20;

    /// <summary>Extra classes for the svg element.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Returns the path markup for a name, or nothing when unknown.</summary>
    private static string Path(string name) => name switch
    {
        "play" => """<polygon points="6 3 20 12 6 21 6 3" fill="currentColor" stroke="none"/>""",
        "pause" => """<rect x="6" y="4" width="4" height="16" rx="1.2" fill="currentColor" stroke="none"/><rect x="14" y="4" width="4" height="16" rx="1.2" fill="currentColor" stroke="none"/>""",
        "stop" => """<rect x="5" y="5" width="14" height="14" rx="2.5" fill="currentColor" stroke="none"/>""",
        "previous" => """<polygon points="18 4 8 12 18 20 18 4" fill="currentColor" stroke="none"/><rect x="5" y="4" width="2.6" height="16" rx="1.2" fill="currentColor" stroke="none"/>""",
        "next" => """<polygon points="6 4 16 12 6 20 6 4" fill="currentColor" stroke="none"/><rect x="16.4" y="4" width="2.6" height="16" rx="1.2" fill="currentColor" stroke="none"/>""",
        "shuffle" => """<path d="M16 3h5v5"/><path d="M4 20 21 3"/><path d="M21 16v5h-5"/><path d="M15 15l6 6"/><path d="M4 4l5 5"/>""",
        "repeat" => """<path d="M17 2l4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="M7 22l-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>""",
        "repeat-one" => """<path d="M17 2l4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="M7 22l-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/><path d="M11 15v-4l-1.5 1"/>""",
        "download" => """<path d="M12 3v12"/><path d="M7 11l5 5 5-5"/><path d="M4 20h16"/>""",
        "trash" => """<path d="M4 7h16"/><path d="M10 11v6M14 11v6"/><path d="M6 7l1 13h10l1-13"/><path d="M9 7V4h6v3"/>""",
        "plus" => """<path d="M12 5v14M5 12h14"/>""",
        "back" => """<path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/>""",
        "search" => """<circle cx="11" cy="11" r="7"/><path d="M20 20l-4.2-4.2"/>""",
        "close" => """<path d="M6 6l12 12M18 6L6 18"/>""",
        "grip" => """<circle cx="9" cy="6" r="1.4" fill="currentColor" stroke="none"/><circle cx="15" cy="6" r="1.4" fill="currentColor" stroke="none"/><circle cx="9" cy="12" r="1.4" fill="currentColor" stroke="none"/><circle cx="15" cy="12" r="1.4" fill="currentColor" stroke="none"/><circle cx="9" cy="18" r="1.4" fill="currentColor" stroke="none"/><circle cx="15" cy="18" r="1.4" fill="currentColor" stroke="none"/>""",
        "heart" => """<path d="M12 20.5l-1.4-1.3C5.4 14.5 2 11.4 2 7.6 2 4.9 4.1 3 6.7 3c1.5 0 3 .7 3.9 1.9L12 6.3l1.4-1.4C14.3 3.7 15.8 3 17.3 3 19.9 3 22 4.9 22 7.6c0 3.8-3.4 6.9-8.6 11.6z" fill="currentColor" stroke="none"/>""",
        "github" => """<path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 016 0C17.6 4.7 18.6 5 18.6 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z" fill="currentColor" stroke="none"/>""",
        "youtube" => """<path d="M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 00.5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 002.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 002.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z" fill="currentColor" stroke="none"/>""",
        "info" => """<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><circle cx="12" cy="7.6" r="1.1" fill="currentColor" stroke="none"/>""",
        "undo" => """<path d="M3 8h11a6 6 0 0 1 0 12h-6"/><path d="M7 4L3 8l4 4"/>""",
        _ => string.Empty,
    };
}
