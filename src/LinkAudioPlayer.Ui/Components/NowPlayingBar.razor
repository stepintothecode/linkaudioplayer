@implements IAsyncDisposable
@inject PlayerController Player
@inject ToastService Toasts
@inject IJSRuntime Js

@* Mirrors what the Android lock screen shows. *@
@if (Player.Current is { } track)
{
    <div class="player">
        @if (Player.IsPreparing)
        {
            <div class="scrubber preparing" style="--progress: @Percent(Player.PrepareProgress)">
                <div class="scrub-fill"></div>
            </div>
        }
        else
        {
            @* The fill transitions between polls, so the bar glides rather than stepping. *@
            <div class="scrubber" style="--progress: @Percent(Fraction)">
                <div class="scrub-fill"></div>
                <input type="range"
                       min="0"
                       max="@Math.Max(Player.Duration.TotalSeconds, 1).ToString("0.###", Culture)"
                       step="0.5"
                       value="@Slider.ToString("0.###", Culture)"
                       aria-label="Seek"
                       @oninput="OnScrub"
                       @onchange="OnSeekCommitted" />
            </div>
        }

        <div class="now">
            @if (Player.QueueName is { } queue)
            {
                <span class="queue-name">@queue</span>
            }
            <div class="marquee" @ref="_titleElement">
                <span class="marquee-text">@track.Title</span>
            </div>
            <span class="time">
                @if (Player.IsPreparing)
                {
                    @($"Downloading {Player.PrepareProgress:P0}")
                }
                else
                {
                    @($"{Format(Player.Position)} / {Format(Player.Duration)}")
                }
            </span>
        </div>

        <div class="transport">
            <button class="btn round @(Player.IsShuffled ? "on" : "")"
                    title="Shuffle" aria-label="Shuffle" @onclick="ToggleShuffle">
                <Icon Name="shuffle" Size="19" />
            </button>
            <button class="btn round" title="Previous" aria-label="Previous" @onclick="Player.PreviousAsync">
                <Icon Name="previous" Size="20" />
            </button>
            <button class="btn round large accent" title="Play or pause" aria-label="Play or pause"
                    disabled="@Player.IsPreparing" @onclick="Player.TogglePlayPauseAsync">
                <Icon Name="@(Player.IsPlaying ? "pause" : "play")" Size="24" />
            </button>
            <button class="btn round" title="Next" aria-label="Next" @onclick="Player.NextAsync">
                <Icon Name="next" Size="20" />
            </button>
            <button class="btn round @(Player.Repeat == RepeatMode.Off ? "" : "on")"
                    title="Loop" aria-label="Loop" @onclick="CycleRepeat">
                <Icon Name="@(Player.Repeat == RepeatMode.One ? "repeat-one" : "repeat")" Size="19" />
            </button>
            <button class="btn round danger" title="Stop" aria-label="Stop" @onclick="StopAsync">
                <Icon Name="stop" Size="19" />
            </button>
        </div>

        @* Playback failures happen off the click path, so they surface here rather
           than through UiErrorState. Without this the play button just goes quiet. *@
        @if (Player.Error is { } error)
        {
            <div class="error player-error" role="alert">
                <span class="text">@error</span>
            </div>
        }
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo Culture =
        System.Globalization.CultureInfo.InvariantCulture;

    private ElementReference _titleElement;
    private IJSObjectReference? _marquee;
    private string? _marqueeFor;
    private double? _scrubbing;

    /// <summary>Position shown on the slider, held steady while the user drags.</summary>
    private double Slider => _scrubbing ?? Player.Position.TotalSeconds;

    /// <summary>Progress from 0 to 1, guarding against an unknown duration.</summary>
    private double Fraction =>
        Player.Duration.TotalSeconds > 0
            ? Math.Clamp(Slider / Player.Duration.TotalSeconds, 0, 1)
            : 0;

    /// <summary>Subscribes to player state so the bar redraws as playback progresses.</summary>
    protected override void OnInitialized() => Player.StateChanged += OnStateChanged;

    /// <summary>Re-measures the title whenever the track changes.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var title = Player.Current?.Title;
        if (title is null || title == _marqueeFor)
        {
            return;
        }

        _marqueeFor = title;

        try
        {
            _marquee ??= await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/LinkAudioPlayer.Ui/js/marquee.js");
            await _marquee.InvokeVoidAsync("observe", _titleElement);
            await _marquee.InvokeVoidAsync("refresh", _titleElement);
        }
        catch (JSException)
        {
            // Scrolling the title is decorative. A static title is a fine fallback.
        }
        catch (JSDisconnectedException)
        {
            // The web view is already gone.
        }
    }

    /// <summary>Toggles shuffle and says what it did, since the icon alone is ambiguous.</summary>
    private void ToggleShuffle()
    {
        Player.ToggleShuffle();
        Toasts.Show(Player.IsShuffled ? "Shuffle on" : "Shuffle off", "shuffle");
    }

    /// <summary>Cycles loop mode and names the mode it landed on.</summary>
    private void CycleRepeat()
    {
        Player.CycleRepeat();

        var (label, icon) = Player.Repeat switch
        {
            RepeatMode.All => ("Loop: all tracks", "repeat"),
            RepeatMode.One => ("Loop: this track", "repeat-one"),
            _ => ("Loop off", "repeat"),
        };

        Toasts.Show(label, icon);
    }

    /// <summary>Stops playback and confirms it, since the bar disappears afterwards.</summary>
    private async Task StopAsync()
    {
        await Player.StopAsync();
        Toasts.Show("Stopped", "stop");
    }

    /// <summary>Unsubscribes and releases the marquee module.</summary>
    public async ValueTask DisposeAsync()
    {
        Player.StateChanged -= OnStateChanged;

        if (_marquee is not null)
        {
            try
            {
                await _marquee.InvokeVoidAsync("unobserve", _titleElement);
                await _marquee.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The web view is already gone.
            }
        }
    }

    /// <summary>Marshals the player callback onto the renderer thread.</summary>
    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Tracks the thumb while dragging, without seeking on every pixel.</summary>
    private void OnScrub(ChangeEventArgs args)
    {
        if (TryRead(args, out var seconds))
        {
            _scrubbing = seconds;
        }
    }

    /// <summary>Seeks once the user lets go.</summary>
    private async Task OnSeekCommitted(ChangeEventArgs args)
    {
        if (TryRead(args, out var seconds))
        {
            await Player.SeekAsync(TimeSpan.FromSeconds(seconds));
        }

        _scrubbing = null;
    }

    private static bool TryRead(ChangeEventArgs args, out double seconds) =>
        double.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Float, Culture, out seconds);

    /// <summary>Formats a fraction as a CSS percentage.</summary>
    private static string Percent(double fraction) =>
        (Math.Clamp(fraction, 0, 1) * 100).ToString("0.##", Culture) + "%";

    /// <summary>Formats a duration as m:ss.</summary>
    private static string Format(TimeSpan value) => value.ToString(@"m\:ss");
}
