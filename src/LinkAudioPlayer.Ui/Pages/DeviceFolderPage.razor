@page "/playlists/device/{FolderId:guid}"
@implements IAsyncDisposable
@inject IDeviceFolderStore Folders
@inject DeviceMusicService Device
@inject PlayerController Player
@inject UiErrorState Errors
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject TabMemory Memory

@* A folder on the phone, played like a playlist. Read only: songs can be reordered
   here, but never removed, because the files belong to the phone. *@

@if (_folder is null)
{
    <p class="empty">@(_loaded ? "This folder has no music any more." : "Loading")</p>
}
else
{
    <div class="page-head">
        <button class="btn round" title="Back to playlists" aria-label="Back to playlists"
                @onclick='() => Nav.NavigateTo("playlists")'>
            <Icon Name="back" Size="20" />
        </button>
        <div class="head-text">
            <h1>@_folder.Name</h1>
            <span class="sub">@(_folder.Path.Length == 0 ? DeviceFolder.RootName : _folder.Path)</span>
        </div>
    </div>

    <div class="row">
        <button class="primary" disabled="@(_songs.Count == 0)" @onclick="() => PlayFromAsync(0)">Play all</button>
    </div>

    <h2>Songs (@_songs.Count)</h2>

    @if (_songs.Count == 0)
    {
        <p class="empty">No music in this folder.</p>
    }
    else
    {
        <p class="hint">Drag the handle to reorder. Your phone's files are never changed.</p>
        <ul class="list reorderable" @ref="_listElement">
            @foreach (var (song, index) in _songs.Select((s, i) => (s, i)))
            {
                <li @key="song.Id" data-index="@index"
                    class="item @(Player.Current?.Id == song.Id ? "playing" : "")">
                    <span class="grip" title="Drag to reorder" aria-label="Reorder">
                        <Icon Name="grip" Size="18" />
                    </span>
                    <div class="meta">
                        <span class="title">@song.Title</span>
                        <span class="sub">@(song.Artist ?? FormatDuration(song.DurationSeconds))</span>
                    </div>
                    <button class="icon" title="Play" aria-label="Play" @onclick="() => PlayFromAsync(index)">
                        <Icon Name="play" Size="18" />
                    </button>
                </li>
            }
        </ul>
    }
}

@code {
    /// <summary>Folder to display, taken from the route.</summary>
    [Parameter]
    public Guid FolderId { get; set; }

    private DeviceFolder? _folder;
    private List<Track> _songs = [];
    private ElementReference _listElement;
    private DotNetObjectReference<DeviceFolderPage>? _self;
    private IJSObjectReference? _reorder;
    private bool _loaded;

    /// <summary>Follows playback and rescans, so the page stays current without a reload.</summary>
    protected override void OnInitialized()
    {
        Player.StateChanged += OnPlayerChanged;
        Device.Changed += OnDeviceChanged;
        _ = Device.RefreshAsync();
    }

    /// <summary>Reloads whenever the route identifier changes.</summary>
    protected override async Task OnParametersSetAsync() => await RefreshAsync();

    private void OnPlayerChanged() => InvokeAsync(StateHasChanged);

    private void OnDeviceChanged() => InvokeAsync(async () =>
    {
        await RefreshAsync();
        StateHasChanged();
    });

    /// <summary>Binds the drag handler once the list exists.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_songs.Count == 0)
        {
            return;
        }

        await Errors.TryAsync("Enabling drag to reorder", async () =>
        {
            _reorder ??= await Js.InvokeAsync<IJSObjectReference>("import", "./_content/LinkAudioPlayer.Ui/js/reorder.js");
            _self ??= DotNetObjectReference.Create(this);
            await _reorder.InvokeVoidAsync("attach", _listElement, _self, nameof(OnReordered));
        });
    }

    /// <summary>Called from JavaScript when a drag finishes on a new position.</summary>
    [JSInvokable]
    public async Task OnReordered(int from, int to)
    {
        if (from == to || from < 0 || from >= _songs.Count || to < 0 || to >= _songs.Count)
        {
            return;
        }

        var ids = _songs.Select(s => s.Id).ToList();
        var moved = ids[from];
        ids.RemoveAt(from);
        ids.Insert(to, moved);

        await Errors.TryAsync(
            "Reordering the folder",
            async () => await Folders.ReorderSongsAsync(FolderId, ids, CancellationToken.None));

        await RefreshAsync();
        StateHasChanged();
    }

    /// <summary>Queues the folder starting at the chosen song.</summary>
    private async Task PlayFromAsync(int index) => await Errors.TryAsync(
        "Playing the folder",
        async () => await Player.PlayQueueAsync(_songs, QueueName, index));

    /// <summary>
    /// Queue name, which is also how a reorder finds the queue to keep in step. Suffixed
    /// so a folder never shares a name with one of your playlists.
    /// </summary>
    private string QueueName => $"{_folder?.Name} on this phone";

    /// <summary>Reloads the folder and its songs.</summary>
    private async Task RefreshAsync() => await Errors.TryAsync("Loading the folder", async () =>
    {
        _folder = await Folders.GetAsync(FolderId, CancellationToken.None);
        _songs = _folder is null ? [] : [.. await Folders.ListSongsAsync(FolderId, CancellationToken.None)];
        _loaded = true;

        if (_folder is null || _songs.Count == 0)
        {
            // Emptied or gone since it was remembered. Forget it so the tab stops reopening it.
            Memory.ClosedPlaylist();
            return;
        }

        Memory.OpenedDeviceFolder(FolderId);
        Player.SyncQueue(_songs, QueueName);
    });

    /// <summary>"3:07", or nothing when the length is unknown.</summary>
    private static string FormatDuration(double? seconds) =>
        seconds is > 0 ? TimeSpan.FromSeconds(seconds.Value).ToString(seconds >= 3600 ? @"h\:mm\:ss" : @"m\:ss") : string.Empty;

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        Player.StateChanged -= OnPlayerChanged;
        Device.Changed -= OnDeviceChanged;

        if (_reorder is not null)
        {
            try
            {
                await _reorder.InvokeVoidAsync("detach", _listElement);
                await _reorder.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The web view is already gone.
            }
        }

        _self?.Dispose();
    }
}
