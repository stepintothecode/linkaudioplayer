@page "/playlists/{PlaylistId:guid}"
@implements IAsyncDisposable
@inject IPlaylistStore Playlists
@inject TrackLibraryService LibraryService
@inject PlayerController Player
@inject UiErrorState Errors
@inject ClipboardService Clipboard
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject ConfirmService Confirm
@inject ToastService Toasts
@inject TabMemory Memory

@if (_playlist is null)
{
    <p class="empty">@(_loaded ? "Playlist not found." : "Loading")</p>
}
else
{
    <div class="page-head">
        <button class="btn round" title="Back to playlists" aria-label="Back to playlists"
                @onclick='() => Nav.NavigateTo("playlists")'>
            <Icon Name="back" Size="20" />
        </button>
        <h1>@_playlist.Name</h1>
    </div>

    <div class="row">
        <button class="primary" disabled="@(_items.Count == 0)" @onclick="PlayAllAsync">Play all</button>
    </div>

    <h2>Tracks (@_items.Count)</h2>

    @if (_items.Count == 0)
    {
        <p class="empty">Empty. Add tracks from the library below.</p>
    }
    else
    {
        <p class="hint">Drag the handle to reorder.</p>
        <ul class="list reorderable" @ref="_listElement">
            @foreach (var (item, index) in _items.Select((e, i) => (e, i)))
            {
                <li @key="item.Id" data-index="@index"
                    class="item @(Player.Current?.Id == item.TrackId ? "playing" : "")">
                    <span class="grip" title="Drag to reorder" aria-label="Reorder">
                        <Icon Name="grip" Size="18" />
                    </span>
                    <img class="art" src="@Artwork(item.Track)" alt="" loading="lazy" />
                    <div class="meta tappable" @onclick="() => ToggleLink(item.TrackId)">
                        <span class="title">@item.Track?.Title</span>
                        <span class="sub">@(item.Track?.Artist ?? item.Track?.Provider)</span>
                    </div>
                    <button class="icon" title="Play" aria-label="Play"
                            @onclick="() => PlayFromAsync(index)" @onclick:stopPropagation>
                        <Icon Name="play" Size="18" />
                    </button>
                    <button class="icon danger" title="Remove from playlist" aria-label="Remove from playlist"
                            @onclick="() => RemoveAsync(item)" @onclick:stopPropagation>
                        <Icon Name="close" Size="18" />
                    </button>

                    @if (_showLinkFor == item.TrackId && item.Track is { } linked)
                    {
                        <div class="link-row">
                            <span class="link-url">@linked.SourceUrl</span>
                            <button class="link-copy" @onclick="() => CopyAsync(linked)"
                                    @onclick:stopPropagation>
                                Copy link
                            </button>
                        </div>
                    }
                </li>
            }
        </ul>
    }

    <h2>Add from library</h2>

    @if (_available.Count == 0)
    {
        <p class="empty">Every library track is already here.</p>
    }
    else
    {
        <ul class="list">
            @foreach (var entry in _available)
            {
                <li class="item">
                    <div class="meta">
                        <span class="title">@entry.Track.Title</span>
                        <span class="sub">@(entry.Track.Artist ?? entry.Track.Provider)</span>
                    </div>
                    <button class="icon" title="Add" aria-label="Add"
                            @onclick="() => AddAsync(entry.Track.Id)">
                        <Icon Name="plus" Size="18" />
                    </button>
                </li>
            }
        </ul>
    }
}

@code {
    /// <summary>Playlist to display, taken from the route.</summary>
    [Parameter]
    public Guid PlaylistId { get; set; }

    private Playlist? _playlist;
    private List<PlaylistItem> _items = [];
    private List<LibraryTrack> _available = [];
    private ElementReference _listElement;
    private Guid? _showLinkFor;
    private DotNetObjectReference<PlaylistDetailPage>? _self;
    private IJSObjectReference? _reorder;
    private bool _loaded;

    /// <summary>Follows playback, so the playing row stays marked as the queue advances.</summary>
    protected override void OnInitialized() => Player.StateChanged += OnPlayerChanged;

    /// <summary>Reloads whenever the route identifier changes.</summary>
    protected override async Task OnParametersSetAsync() => await RefreshAsync();

    /// <summary>Redraws when the player moves to another track.</summary>
    private void OnPlayerChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Shows or hides the link for one row. Only one is open at a time.</summary>
    private void ToggleLink(Guid trackId) =>
        _showLinkFor = _showLinkFor == trackId ? null : trackId;

    /// <summary>Copies a track's original URL.</summary>
    private async Task CopyAsync(Track track)
    {
        var copied = await Clipboard.CopyAsync(track.SourceUrl);
        Toasts.Show(copied ? "Link copied" : "Could not copy the link", copied ? "plus" : null);
    }

    /// <summary>Binds the drag handler once the list exists.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_items.Count == 0)
        {
            return;
        }

        await Errors.TryAsync("Enabling drag to reorder", async () =>
        {
            _reorder ??= await Js.InvokeAsync<IJSObjectReference>("import", "./_content/LinkAudioPlayer.Ui/js/reorder.js");
            _self ??= DotNetObjectReference.Create(this);
            await _reorder.InvokeVoidAsync("attach", _listElement, _self, nameof(OnReordered));
        });
    }

    /// <summary>Called from JavaScript when a drag finishes on a new position.</summary>
    [JSInvokable]
    public async Task OnReordered(int from, int to)
    {
        if (from == to || from < 0 || from >= _items.Count || to < 0 || to >= _items.Count)
        {
            return;
        }

        var ids = _items.Select(i => i.Id).ToList();
        var moved = ids[from];
        ids.RemoveAt(from);
        ids.Insert(to, moved);

        await Errors.TryAsync(
            "Reordering the playlist",
            async () => await Playlists.ReorderAsync(PlaylistId, ids, CancellationToken.None));

        await RefreshAsync();
        StateHasChanged();
    }

    /// <summary>Queues the playlist from the first track.</summary>
    private async Task PlayAllAsync() => await PlayFromAsync(0);

    /// <summary>Queues the playlist starting at the chosen entry.</summary>
    private async Task PlayFromAsync(int index) => await Errors.TryAsync("Playing the playlist", async () =>
    {
        var tracks = _items.Select(i => i.Track).OfType<Track>().ToList();
        await Player.PlayQueueAsync(tracks, _playlist?.Name ?? "Playlist", index);
    });

    /// <summary>Appends a library track to this playlist.</summary>
    private async Task AddAsync(Guid trackId)
    {
        await Errors.TryAsync(
            "Adding to the playlist",
            async () => await Playlists.AddTrackAsync(PlaylistId, trackId, CancellationToken.None));

        await RefreshAsync();
    }

    /// <summary>
    /// Removes one entry, with an undo.
    /// No confirmation here: this only unlinks a track from a playlist, and the track
    /// itself stays in the library, so the undo alone is enough of a safety net.
    /// </summary>
    private async Task RemoveAsync(PlaylistItem item)
    {
        var trackId = item.TrackId;
        var order = _items.Select(i => i.TrackId).ToList();

        await Errors.TryAsync(
            "Removing from the playlist",
            async () => await Playlists.RemoveItemAsync(PlaylistId, item.Id, CancellationToken.None));

        await RefreshAsync();

        Toasts.ShowWithAction(
            $"Removed from {_playlist?.Name}",
            "Undo",
            () => UndoRemoveAsync(trackId, order),
            "close");
    }

    /// <summary>Puts an entry back at the position it held.</summary>
    private async Task UndoRemoveAsync(Guid trackId, IReadOnlyList<Guid> orderBefore)
    {
        await Errors.TryAsync("Restoring the entry", async () =>
        {
            await Playlists.AddTrackAsync(PlaylistId, trackId, CancellationToken.None);

            var playlist = await Playlists.GetAsync(PlaylistId, CancellationToken.None);
            if (playlist is null)
            {
                return;
            }

            // Re-added at the end, so the captured order is applied to put it back.
            var itemsByTrack = playlist.Items
                .GroupBy(i => i.TrackId)
                .ToDictionary(g => g.Key, g => g.First().Id);

            var ids = orderBefore.Where(itemsByTrack.ContainsKey).Select(id => itemsByTrack[id]).ToList();
            if (ids.Count == playlist.Items.Count)
            {
                await Playlists.ReorderAsync(PlaylistId, ids, CancellationToken.None);
            }
        });

        await RefreshAsync();
        StateHasChanged();
    }

    /// <summary>Reloads the playlist and the set of tracks not yet in it.</summary>
    private async Task RefreshAsync() => await Errors.TryAsync("Loading the playlist", async () =>
    {
        _playlist = await Playlists.GetAsync(PlaylistId, CancellationToken.None);
        _loaded = true;

        if (_playlist is null)
        {
            // Deleted while it was remembered. Forgetting it stops the tab reopening
            // a playlist that is no longer there.
            Memory.ClosedPlaylist();
            _items = [];
            _available = [];
            return;
        }

        Memory.OpenedPlaylist(PlaylistId);

        _items = [.. _playlist.Items.OrderBy(i => i.Position)];

        // Keeps a queue started from this playlist in step with an edit.
        Player.SyncQueue(_items.Select(i => i.Track).OfType<Track>(), _playlist.Name);

        var present = _items.Select(i => i.TrackId).ToHashSet();
        var library = await LibraryService.ListAsync(CancellationToken.None);
        _available = [.. library.Where(t => !present.Contains(t.Track.Id))];
    });

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        Player.StateChanged -= OnPlayerChanged;

        if (_reorder is not null)
        {
            try
            {
                await _reorder.InvokeVoidAsync("detach", _listElement);
                await _reorder.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The web view is already gone.
            }
        }

        _self?.Dispose();
    }

    /// <summary>Falls back to the app icon when a track has no artwork.</summary>
    private static string Artwork(Track? track) =>
        track?.ThumbnailUrl ?? "_content/LinkAudioPlayer.Ui/icon.png";
}
