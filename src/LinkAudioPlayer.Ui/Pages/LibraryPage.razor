@page "/"
@implements IAsyncDisposable
@inject TrackLibraryService LibraryService
@inject RemovalService Removal
@inject PlayerController Player
@inject UiErrorState Errors
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject ClipboardService Clipboard
@inject AudioSaveTracker Saver
@inject SharedLinkInbox Shared
@inject IJSRuntime Js

<h1 class="visually-hidden">Library</h1>

<div class="row">
    <input type="url"
           inputmode="url"
           placeholder="Paste a YouTube video or playlist link"
           @bind="_url"
           @bind:event="oninput"
           @onkeydown="OnKeyDown" />
    <button class="btn round" title="Paste" aria-label="Paste from clipboard" @onclick="PasteAsync">
        <Icon Name="paste" Size="20" />
    </button>
    <button class="primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_url))" @onclick="AddAsync">
        @(_busy ? "Adding" : "Add")
    </button>
</div>

@* Saving is separate from adding: it writes a file to the phone and leaves the
   library alone. *@
<div class="save-row">
    <span class="save-label">@(Saver.Status ?? "Save audio to phone")</span>
    <button class="save-button" disabled="@(Saver.IsBusy || string.IsNullOrWhiteSpace(_url))"
            title="Save as M4A" @onclick="() => SaveAsync(AudioFormat.M4a)">
        M4A <Icon Name="download" Size="16" />
    </button>
    <button class="save-button" disabled="@(Saver.IsBusy || string.IsNullOrWhiteSpace(_url))"
            title="Save as MP3" @onclick="() => SaveAsync(AudioFormat.Mp3)">
        MP3 <Icon Name="download" Size="16" />
    </button>
</div>

@if (_tracks.Count > 0)
{
    <div class="search-field">
        <Icon Name="search" Size="17" Class="search-glyph" />
        <input type="text" inputmode="search" placeholder="Search your tracks"
               @bind="_search" @bind:event="oninput" />
        @if (!string.IsNullOrEmpty(_search))
        {
            <button class="search-clear" title="Clear search" @onclick='() => _search = string.Empty'>
                <Icon Name="close" Size="15" />
            </button>
        }
    </div>
}

<h2>Tracks (@Visible.Count@(IsFiltered ? $" of {_tracks.Count}" : ""))</h2>

@if (_downloadNote is { } note)
{
    <p class="note">@note</p>
}

@if (_tracks.Count == 0)
{
    <p class="empty">Nothing here yet. Add a link above.</p>
}
else if (Visible.Count == 0)
{
    <p class="empty">No track matches that search.</p>
}
else
{
    @* Reordering is disabled while filtering, because positions would be ambiguous. *@
    <p class="hint">@(IsFiltered ? "Clear the search to reorder." : "Drag the handle to reorder.")</p>
    <ul class="list @(IsFiltered ? "" : "reorderable")" @ref="_listElement">
        @foreach (var (entry, index) in Visible.Select((t, i) => (t, i)))
        {
            <li @key="entry.Track.Id" data-index="@index"
                class="item @(Player.Current?.Id == entry.Track.Id ? "playing" : "")">
                @if (!IsFiltered)
                {
                    <span class="grip" title="Drag to reorder" aria-label="Reorder">
                        <Icon Name="grip" Size="18" />
                    </span>
                }
                <img class="art" src="@Artwork(entry.Track)" alt="" loading="lazy" />
                <div class="meta tappable" @onclick="() => ToggleLink(entry.Track.Id)">
                    <span class="title">@entry.Track.Title</span>
                    <span class="sub">@(entry.Track.Artist ?? entry.Track.Provider)</span>
                </div>
                <button class="icon" title="Play" aria-label="Play"
                        @onclick="() => PlayFromAsync(index)" @onclick:stopPropagation>
                    <Icon Name="play" Size="18" />
                </button>
                @* Hidden once the track is saved. A permanently disabled button says
                   nothing the missing button does not say more quietly. *@
                @if (!entry.IsDownloaded)
                {
                    <button class="icon" title="Save for offline" aria-label="Save for offline"
                            disabled="@_downloading.Contains(entry.Track.Id)"
                            @onclick="() => DownloadAsync(entry.Track)" @onclick:stopPropagation>
                        <Icon Name="download" Size="18" />
                    </button>
                }
                <button class="icon danger" title="Remove" aria-label="Remove"
                        @onclick="() => DeleteAsync(entry.Track)" @onclick:stopPropagation>
                    <Icon Name="trash" Size="18" />
                </button>

                @if (_showLinkFor == entry.Track.Id)
                {
                    <div class="link-row">
                        <span class="link-url">@entry.Track.SourceUrl</span>
                        <button class="link-copy" @onclick="() => CopyAsync(entry.Track)"
                                @onclick:stopPropagation>
                            Copy link
                        </button>
                    </div>
                }
            </li>
        }
    </ul>
}

@code {
    private List<LibraryTrack> _tracks = [];
    private readonly HashSet<Guid> _downloading = [];
    private ElementReference _listElement;
    private DotNetObjectReference<LibraryPage>? _self;
    private IJSObjectReference? _reorder;
    private string _url = string.Empty;
    private string _search = string.Empty;
    private string? _downloadNote;
    private Guid? _showLinkFor;
    private bool _busy;

    /// <summary>True when a search is narrowing the list.</summary>
    private bool IsFiltered => !string.IsNullOrWhiteSpace(_search);

    /// <summary>Tracks matching the current search, or all of them.</summary>
    private List<LibraryTrack> Visible =>
        IsFiltered
            ? [.. _tracks.Where(t => Matches(t, _search.Trim()))]
            : _tracks;

    /// <summary>Loads the library and follows playback, so the playing row stays marked.</summary>
    protected override async Task OnInitializedAsync()
    {
        Player.StateChanged += OnPlayerChanged;
        Saver.Changed += OnPlayerChanged;
        Shared.Arrived += OnLinkShared;
        TakeSharedLink();
        await RefreshAsync();
    }

    /// <summary>A link shared while this page is showing.</summary>
    private void OnLinkShared() => InvokeAsync(() =>
    {
        TakeSharedLink();
        StateHasChanged();
    });

    /// <summary>
    /// Puts a link shared from another app, such as YouTube, into the field. It is not
    /// added straight away, so you can still choose between Add, M4A and MP3.
    /// </summary>
    private void TakeSharedLink()
    {
        if (Shared.Take() is { } url)
        {
            _url = url;
            Toasts.Show("Link ready. Add it, or save it as M4A or MP3", "plus");
        }
    }

    /// <summary>Replaces the field with the clipboard, saving the long press.</summary>
    private async Task PasteAsync()
    {
        var text = await Clipboard.PasteAsync();
        if (text is null)
        {
            Toasts.Show("Nothing to paste");
            return;
        }

        _url = text;
    }

    /// <summary>Saves the link's audio as a file. The link stays in the field, so both formats can be saved.</summary>
    private async Task SaveAsync(AudioFormat format) => await Saver.SaveAsync(_url, format);

    /// <summary>Matches a track on title, artist or provider.</summary>
    private static bool Matches(LibraryTrack entry, string term) =>
        entry.Track.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
        || (entry.Track.Artist?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
        || entry.Track.Provider.Contains(term, StringComparison.OrdinalIgnoreCase);

    /// <summary>Redraws when the player moves to another track.</summary>
    private void OnPlayerChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Shows or hides the link for one row. Only one is open at a time.</summary>
    private void ToggleLink(Guid trackId) =>
        _showLinkFor = _showLinkFor == trackId ? null : trackId;

    /// <summary>Copies a track's original URL.</summary>
    private async Task CopyAsync(Track track)
    {
        var copied = await Clipboard.CopyAsync(track.SourceUrl);
        Toasts.Show(copied ? "Link copied" : "Could not copy the link", copied ? "plus" : null);
    }

    /// <summary>Binds the drag handler once the list exists.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_tracks.Count == 0 || IsFiltered)
        {
            return;
        }

        await Errors.TryAsync("Enabling drag to reorder", async () =>
        {
            _reorder ??= await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/LinkAudioPlayer.Ui/js/reorder.js");
            _self ??= DotNetObjectReference.Create(this);
            await _reorder.InvokeVoidAsync("attach", _listElement, _self, nameof(OnReordered));
        });
    }

    /// <summary>Called from JavaScript when a drag finishes on a new position.</summary>
    [JSInvokable]
    public async Task OnReordered(int from, int to)
    {
        if (from == to || from < 0 || from >= _tracks.Count || to < 0 || to >= _tracks.Count)
        {
            return;
        }

        var ids = _tracks.Select(t => t.Track.Id).ToList();
        var moved = ids[from];
        ids.RemoveAt(from);
        ids.Insert(to, moved);

        await Errors.TryAsync(
            "Reordering the library",
            async () => await LibraryService.ReorderAsync(ids, CancellationToken.None));

        await RefreshAsync();
        StateHasChanged();
    }

    /// <summary>Submits the URL when the user presses Enter.</summary>
    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await AddAsync();
        }
    }

    /// <summary>Resolves the entered URL and adds the track.</summary>
    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_url) || _busy)
        {
            return;
        }

        _busy = true;
        var url = _url.Trim();
        var count = 0;

        var ok = await Errors.TryAsync(
            "Adding the link",
            async () => count = (await LibraryService.AddFromUrlAsync(url, CancellationToken.None)).Count);

        if (ok)
        {
            _url = string.Empty;
            Toasts.Show(count == 1 ? "Added 1 track" : $"Added {count} tracks", "plus");
        }

        _busy = false;
        await RefreshAsync();
    }

    /// <summary>Queues the whole library starting at the chosen track.</summary>
    private async Task PlayFromAsync(int index) => await Errors.TryAsync(
        "Playing the track",
        async () => await Player.PlayQueueAsync(Visible.Select(t => t.Track), "Library Tracks", index));

    /// <summary>Downloads a track so it plays instantly and works offline.</summary>
    private async Task DownloadAsync(Track track)
    {
        _downloading.Add(track.Id);
        _downloadNote = $"Downloading \"{track.Title}\" in the background so it plays offline.";

        await Errors.TryAsync(
            "Downloading the track",
            async () => await LibraryService.DownloadAsync(track.Id, progress: null, CancellationToken.None));

        _downloading.Remove(track.Id);
        _downloadNote = null;
        await RefreshAsync();
    }

    /// <summary>Confirms, removes, then offers a few seconds to undo.</summary>
    private async Task DeleteAsync(Track track)
    {
        var confirmed = await Confirm.AskAsync(
            "Remove this track?",
            $"\"{track.Title}\" will be removed from your library and from every playlist it is in.",
            "Remove");

        if (!confirmed)
        {
            return;
        }

        RemovedTrack? removed = null;

        await Errors.TryAsync(
            "Removing the track",
            async () => removed = await Removal.RemoveTrackAsync(track.Id, CancellationToken.None));

        await RefreshAsync();

        if (removed is { } snapshot)
        {
            Toasts.ShowWithAction("Track removed", "Undo", () => UndoAsync(snapshot), "trash");
        }
    }

    /// <summary>Puts a removed track back where it was.</summary>
    private async Task UndoAsync(RemovedTrack removed)
    {
        await Errors.TryAsync(
            "Restoring the track",
            async () => await Removal.RestoreAsync(removed, CancellationToken.None));

        await RefreshAsync();
        StateHasChanged();
    }

    /// <summary>Reloads the track list.</summary>
    private async Task RefreshAsync() => await Errors.TryAsync("Loading the library", async () =>
    {
        _tracks = [.. await LibraryService.ListAsync(CancellationToken.None)];

        // Keeps a queue started from the library in step with a reorder or removal.
        Player.SyncQueue(_tracks.Select(t => t.Track), "Library Tracks");
    });

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        Player.StateChanged -= OnPlayerChanged;
        Saver.Changed -= OnPlayerChanged;
        Shared.Arrived -= OnLinkShared;

        if (_reorder is not null)
        {
            try
            {
                await _reorder.InvokeVoidAsync("detach", _listElement);
                await _reorder.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The web view is already gone.
            }
        }

        _self?.Dispose();
    }

    /// <summary>Falls back to the app icon when a track has no artwork.</summary>
    private static string Artwork(Track track) =>
        track.ThumbnailUrl ?? "_content/LinkAudioPlayer.Ui/icon.png";
}
