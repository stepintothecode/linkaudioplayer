@page "/playlists/{PlaylistId:guid}"
@inject MusicPlayerApiClient Api
@inject PlayerService Player

<PageTitle>@(_playlist?.Name ?? "Playlist")</PageTitle>

@if (_playlist is null)
{
    <p class="empty">@(_loaded ? "Playlist not found." : "Loading")</p>
}
else
{
    <h1>@_playlist.Name</h1>

    <div class="row">
        <button class="primary" disabled="@(_playlist.Entries.Count == 0)" @onclick="PlayAllAsync">Play all</button>
    </div>

    <h2>Tracks (@_playlist.Entries.Count)</h2>

    @if (_playlist.Entries.Count == 0)
    {
        <p class="empty">Empty. Add tracks from the library below.</p>
    }
    else
    {
        <ul class="list">
            @foreach (var (entry, index) in _playlist.Entries.Select((e, i) => (e, i)))
            {
                <li class="item @(Player.Current?.Id == entry.Track.Id ? "playing" : "")">
                    <img class="art" src="@(entry.Track.ThumbnailUrl ?? "icon.svg")" alt="" loading="lazy" />
                    <div class="meta">
                        <span class="title">@entry.Track.Title</span>
                        <span class="sub">@(entry.Track.Artist ?? entry.Track.Provider)</span>
                    </div>
                    <button class="icon" title="Play" @onclick="() => PlayFromAsync(index)">▶</button>
                    <button class="icon" title="Move up" disabled="@(index == 0)"
                            @onclick="() => MoveAsync(index, index - 1)">↑</button>
                    <button class="icon" title="Move down" disabled="@(index == _playlist.Entries.Count - 1)"
                            @onclick="() => MoveAsync(index, index + 1)">↓</button>
                    <button class="icon" title="Remove" @onclick="() => RemoveAsync(entry.ItemId)">✕</button>
                </li>
            }
        </ul>
    }

    <h2>Add from library</h2>

    @if (_available.Count == 0)
    {
        <p class="empty">Every library track is already here.</p>
    }
    else
    {
        <ul class="list">
            @foreach (var track in _available)
            {
                <li class="item">
                    <div class="meta">
                        <span class="title">@track.Title</span>
                        <span class="sub">@(track.Artist ?? track.Provider)</span>
                    </div>
                    <button class="icon" title="Add" @onclick="() => AddAsync(track.Id)">+</button>
                </li>
            }
        </ul>
    }
}

@code {
    /// <summary>Playlist to display, taken from the route.</summary>
    [Parameter]
    public Guid PlaylistId { get; set; }

    private PlaylistDetailDto? _playlist;
    private List<TrackDto> _available = [];
    private bool _loaded;

    /// <summary>Reloads whenever the route identifier changes.</summary>
    protected override async Task OnParametersSetAsync() => await RefreshAsync();

    /// <summary>Queues the playlist from the first track.</summary>
    private async Task PlayAllAsync() => await PlayFromAsync(0);

    /// <summary>Queues the playlist starting at the chosen entry.</summary>
    private async Task PlayFromAsync(int index)
    {
        if (_playlist is null)
        {
            return;
        }

        await Player.PlayQueueAsync(_playlist.Entries.Select(e => e.Track), index);
    }

    /// <summary>Appends a library track to this playlist.</summary>
    private async Task AddAsync(Guid trackId)
    {
        await Api.AddToPlaylistAsync(PlaylistId, trackId);
        await RefreshAsync();
    }

    /// <summary>Removes an entry from this playlist.</summary>
    private async Task RemoveAsync(Guid itemId)
    {
        await Api.RemoveFromPlaylistAsync(PlaylistId, itemId);
        await RefreshAsync();
    }

    /// <summary>Swaps two entries and persists the new order.</summary>
    private async Task MoveAsync(int from, int to)
    {
        if (_playlist is null || to < 0 || to >= _playlist.Entries.Count)
        {
            return;
        }

        var ids = _playlist.Entries.Select(e => e.ItemId).ToList();
        (ids[from], ids[to]) = (ids[to], ids[from]);

        await Api.ReorderPlaylistAsync(PlaylistId, ids);
        await RefreshAsync();
    }

    /// <summary>Reloads the playlist and the set of tracks not yet in it.</summary>
    private async Task RefreshAsync()
    {
        _playlist = await Api.GetPlaylistAsync(PlaylistId);
        _loaded = true;

        if (_playlist is null)
        {
            _available = [];
            return;
        }

        var present = _playlist.Entries.Select(e => e.Track.Id).ToHashSet();
        var library = await Api.GetTracksAsync();
        _available = [.. library.Where(t => !present.Contains(t.Id))];
    }
}
