@implements IDisposable
@inject PlayerService Player

@* Transport controls mirroring what the lock screen shows. *@
@if (Player.Current is { } track)
{
    <div class="player">
        <div class="inner">
            <button class="icon" @onclick="Player.PreviousAsync" title="Previous">&#9198;</button>
            <button class="icon primary" @onclick="Player.TogglePlayPauseAsync" title="Play or pause">
                @(Player.IsPlaying ? "⏸" : "▶")
            </button>
            <button class="icon" @onclick="Player.NextAsync" title="Next">&#9197;</button>

            <div class="track">
                <span class="title">@track.Title</span>
                <span class="time">@Format(Player.PositionSeconds) / @Format(Player.DurationSeconds)</span>
                <input type="range"
                       min="0"
                       max="@Math.Max(Player.DurationSeconds, 1)"
                       step="1"
                       value="@Player.PositionSeconds"
                       @onchange="OnSeek" />
            </div>

            <button class="icon" @onclick="Player.StopAsync" title="Stop">&#9209;</button>
        </div>

        @if (Player.Error is { } error)
        {
            <div class="error">@error</div>
        }
    </div>
}

@code {
    /// <summary>Subscribes to player state so the bar redraws as playback progresses.</summary>
    protected override void OnInitialized() => Player.StateChanged += OnStateChanged;

    /// <summary>Unsubscribes to avoid leaking the handler.</summary>
    public void Dispose() => Player.StateChanged -= OnStateChanged;

    /// <summary>Marshals the player callback onto the renderer thread.</summary>
    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Seeks when the user drags the scrubber.</summary>
    private async Task OnSeek(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var seconds))
        {
            await Player.SeekAsync(seconds);
        }
    }

    /// <summary>Formats seconds as m:ss.</summary>
    private static string Format(double seconds) =>
        double.IsFinite(seconds) ? TimeSpan.FromSeconds(seconds).ToString(@"m\:ss") : "0:00";
}
